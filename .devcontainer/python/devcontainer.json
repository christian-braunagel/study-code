{
    "name": "Python",
    "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",
    "remoteUser": "vscode",
    "features": {
        "ghcr.io/devcontainers/features/git-lfs:1": {}
    },
    "remoteEnv": {
        "VIRTUAL_ENV": "/home/vscode/.venv",
        "PATH": "/home/vscode/.venv/bin:${containerEnv:PATH}"
    },
    "postCreateCommand": "python3 -m venv /home/vscode/.venv && /home/vscode/.venv/bin/python -m pip install --upgrade pip setuptools wheel pytest ruff",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "charliermarsh.ruff"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
                "python.terminal.activateEnvironment": true,
                "python.testing.pytestEnabled": true,
                "python.testing.unittestEnabled": false,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true,
                    "editor.codeActionsOnSave": {
                        "source.organizeImports.ruff": "explicit"
                    }
                }
            }
        }
    }
}
