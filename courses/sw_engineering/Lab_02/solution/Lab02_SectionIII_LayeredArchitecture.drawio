        <mxCell id="yXmKdywUl60F6FBw0xmS-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Application Layer&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Coordinates/calls all relevant services of the Domain Layer if&lt;br&gt;&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;user places an order&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;user opens the product catalogue&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;user clicks on a product to see the details&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;&lt;u&gt;It also validates the products availability&lt;/u&gt;&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="380" x="800" y="230" as="geometry" />
        </mxCell>
        <mxCell id="yXmKdywUl60F6FBw0xmS-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Data Layer&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Interaction with Database&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Storing products, customers, and payments&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="380" x="800" y="600" as="geometry" />
        </mxCell>
        <mxCell id="yXmKdywUl60F6FBw0xmS-14" edge="1" parent="1" source="yXmKdywUl60F6FBw0xmS-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="yXmKdywUl60F6FBw0xmS-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yXmKdywUl60F6FBw0xmS-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;Business Layer&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Includes all the business logic such as&amp;nbsp;calculating prices, discounts, tax and shipping costs&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;For all of that, it requires data from the data layer&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="380" x="800" y="421" as="geometry" />
        </mxCell>
        <mxCell id="yXmKdywUl60F6FBw0xmS-16" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Example as Open Architecture&lt;/h1&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="902" y="-90" as="geometry" />
        </mxCell>
        <mxCell id="yXmKdywUl60F6FBw0xmS-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Benefits:&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Simple structure and linear communication&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Downsides:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;Process Overhead because every access to the Data Layer needs to be routed via Business Layer. That means that even if the application layer requires some data that does not need to be process by the business layer, we need to call a domain layer method.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="260" width="220" x="320" y="770" as="geometry" />
        </mxCell>
        <mxCell id="yXmKdywUl60F6FBw0xmS-19" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Benefits:&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Increased performance since the application layer can directly access the data layer and retrieve data without going via business layer&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Downsides:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;Slightly more complex due to additional communication path&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="260" width="220" x="900" y="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
