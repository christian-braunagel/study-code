        <mxCell id="yXmKdywUl60F6FBw0xmS-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Application Layer&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Coordinates/calls all relevant services of the Domain Layer if&lt;br&gt;&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;user places an order&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;user opens the product catalogue&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;user clicks on a product to see the details&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="380" x="230" y="240" as="geometry" />
        </mxCell>
        <mxCell id="yXmKdywUl60F6FBw0xmS-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Data Layer&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Interaction with Database&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Storing products, customers, and payments&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="380" x="230" y="600" as="geometry" />
        </mxCell>
        <mxCell id="yXmKdywUl60F6FBw0xmS-7" edge="1" parent="1" source="yXmKdywUl60F6FBw0xmS-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="yXmKdywUl60F6FBw0xmS-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yXmKdywUl60F6FBw0xmS-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;Business Layer&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Includes all the business logic such as&amp;nbsp;calculating prices, discounts, tax and shipping costs&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;&lt;b&gt;It also validates the products availability&lt;/b&gt;&lt;/u&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;For all of that, it requires data from the data layer&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="380" x="230" y="421" as="geometry" />
        </mxCell>
        <mxCell id="yXmKdywUl60F6FBw0xmS-8" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Example as Closed Architecture&lt;/h1&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="332" y="-90" as="geometry" />
        </mxCell>
        <mxCell id="yXmKdywUl60F6FBw0xmS-9" edge="1" parent="1" source="yXmKdywUl60F6FBw0xmS-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="yXmKdywUl60F6FBw0xmS-12">
